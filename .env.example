# Локальная CSV-демонстрация. Стандартный docker compose использует эти значения по умолчанию.
# Запуск через SSH описан в docs/stage3-production.md.
# Скопируйте файл в .env только если нужно переопределить настройки локально
# (например, задать другой пароль БД или порт приложения). Файл .env в Git не попадает.
DB_NAME=client_matcher
DB_USER=client_matcher
DB_PASSWORD=client_matcher
APP_PORT=8080

# Для прямого запуска backend без Compose действуют следующие значения по умолчанию.
# Стандартный Compose использует CSV. SITE_DB_* ниже нужны для прямого запуска backend с PostgreSQL сайта.
# DB_TRANSPORT=direct
# CRM_SOURCE=csv
# CRM_PATH=../testdata/crm.csv
# Для CRM_SOURCE=bitrix24 требуется BITRIX24_WEBHOOK_URL из защищённого окружения.
# CRM_PATH требуется только для CSV. При сбое Bitrix24 запрос завершается ошибкой.
# SITE_SOURCE=csv
# SITE_PATH=../testdata/site.csv
# Пример отдельной локальной PostgreSQL с синтетической таблицей public.children:
# SITE_SOURCE=postgres
# SITE_DB_HOST=127.0.0.1
# SITE_DB_PORT=55482
# SITE_DB_USER=demo_site_reader
# SITE_DB_PASSWORD=demo_site_password
# SITE_DB_NAME=demo_site
# SITE_DB_SSLMODE=disable
