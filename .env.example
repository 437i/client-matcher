# Необязательно: docker compose использует эти же значения по умолчанию.
# Скопируйте файл в .env только если нужно переопределить настройки локально
# (например, задать другой пароль БД или порт приложения). Файл .env в Git не попадает.
DB_NAME=client_matcher
DB_USER=client_matcher
DB_PASSWORD=client_matcher
APP_PORT=8080

# При прямом запуске backend CSV сайта — источник по умолчанию.
# SITE_SOURCE=csv
# SITE_PATH=../testdata/site.csv
# Пример отдельной локальной PostgreSQL с синтетической таблицей public.children:
# SITE_SOURCE=postgres
# SITE_DB_HOST=127.0.0.1
# SITE_DB_PORT=55482
# SITE_DB_USER=demo_site_reader
# SITE_DB_PASSWORD=demo_site_password
# SITE_DB_NAME=demo_site
# SITE_DB_SSLMODE=disable
