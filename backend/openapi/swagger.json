{
    "components": {
        "schemas": {
            "handlers.CRMClientResponse": {
                "properties": {
                    "birthday": {
                        "description": "YYYY-MM-DD",
                        "type": "string"
                    },
                    "clinic": {
                        "type": "string"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "full_name": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    },
                    "patronymic": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "handlers.CreateRequest": {
                "properties": {
                    "crm_id": {
                        "type": "string"
                    },
                    "site_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "crm_id",
                    "site_id"
                ],
                "type": "object"
            },
            "handlers.ErrorResponse": {
                "properties": {
                    "code": {
                        "example": "crm_client_not_found",
                        "type": "string"
                    },
                    "message": {
                        "example": "Клиент не найден в CRM",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "handlers.LinkResponse": {
                "properties": {
                    "created_at": {
                        "description": "RFC 3339, например 2026-11-11T21:00:00Z",
                        "type": "string"
                    },
                    "crm_id": {
                        "type": "string"
                    },
                    "id": {
                        "description": "UUID связи",
                        "type": "string"
                    },
                    "site_id": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "handlers.SiteClientResponse": {
                "properties": {
                    "birthday": {
                        "description": "YYYY-MM-DD",
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    },
                    "short_name": {
                        "type": "string"
                    }
                },
                "type": "object"
            }
        }
    },
    "info": {
        "description": "REST API для ручного сопоставления ID клиента в CRM и ID клиента на сайте.",
        "title": "Client Matcher API",
        "version": "1.0.0"
    },
    "externalDocs": {
        "description": "Исходный код и инструкции по запуску проекта.",
        "url": "https://github.com/437i/client-matcher"
    },
    "paths": {
        "/api/v1/crm-clients": {
            "get": {
                "description": "Ищет по любой части ФИО, порядок слов не важен. Поддерживает нормализацию, варианты имён, частичные совпадения и ограниченный поиск опечаток. Возвращает не более 50 кандидатов; результат не подтверждает личность.",
                "parameters": [
                    {
                        "description": "Любая часть ФИО; порядок слов не важен",
                        "example": "артем семенов",
                        "in": "query",
                        "name": "q",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/handlers.CRMClientResponse"
                                    },
                                    "type": "array"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Bad Request"
                    },
                    "499": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Запрос отменён клиентом (нестандартный код 499)"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "504": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Превышено время ожидания"
                    }
                },
                "summary": "Поиск клиентов в CRM",
                "tags": [
                    "crm"
                ]
            }
        },
        "/api/v1/links": {
            "get": {
                "description": "Возвращает все сохранённые связи между клиентами CRM и сайта.",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/handlers.LinkResponse"
                                    },
                                    "type": "array"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "499": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Запрос отменён клиентом (нестандартный код 499)"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "504": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Превышено время ожидания"
                    }
                },
                "summary": "Список связей",
                "tags": [
                    "links"
                ]
            },
            "post": {
                "description": "Создаёт связь между клиентом CRM и клиентом сайта после проверки совпадения фамилии и даты рождения.",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/handlers.CreateRequest",
                                "summary": "request",
                                "description": "Пара идентификаторов"
                            }
                        }
                    },
                    "description": "Пара идентификаторов",
                    "required": true
                },
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.LinkResponse"
                                }
                            }
                        },
                        "description": "Created"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Bad Request"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Not Found"
                    },
                    "409": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Conflict"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Unprocessable Entity"
                    },
                    "499": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Запрос отменён клиентом (нестандартный код 499)"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "502": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Источник вернул некорректные данные клиента"
                    },
                    "504": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Превышено время ожидания"
                    }
                },
                "summary": "Создать связь CRM и сайта",
                "tags": [
                    "links"
                ]
            }
        },
